# CropSense AI Backend — Environment Variables
# Set these in the backend process/deployment environment. The app does not
# automatically load a local `.env` file.

# Comma-separated browser origins permitted by the backend CORS policy.
# Defaults to the two local Vite origins if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In deployment, replace the local origins with the exact frontend origin(s),
# for example: CORS_ORIGINS=https://app.example.com
